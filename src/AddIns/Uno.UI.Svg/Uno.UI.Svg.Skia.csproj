<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override.props" />

	<PropertyGroup>
		<Deterministic>true</Deterministic>

		<AssemblyName>Uno.UI.Svg</AssemblyName>
		<RootNamespace>Uno.UI.Svg</RootNamespace>

		<UnoRuntimeIdentifier>Skia</UnoRuntimeIdentifier>
		<UseCommonOverridePackage>true</UseCommonOverridePackage>
		<CommonOverridePackageId>Uno.WinUI.Svg</CommonOverridePackageId>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Svg.Skia" />
		<PackageReference Include="SkiaSharp.Views.Uno.WinUI" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Uno.Foundation\Uno.Foundation.Skia.csproj" />
		<ProjectReference Include="..\..\Uno.UI\Uno.UI.Skia.csproj" />
		<ProjectReference Include="..\Uno.WinUI.Graphics2DSK\Uno.WinUI.Graphics2DSK.Crossruntime.csproj" />
	</ItemGroup>

</Project>
